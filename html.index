<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guessing Game</title>
  <style>
    body {
      background-color: #111;
      color: #f0f0f0;
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 40px;
    }
    h1 {
      color: #ffcc00;
    }
    input {
      padding: 8px;
      margin-top: 10px;
      border: none;
      border-radius: 4px;
    }
    button {
      padding: 8px 12px;
      margin-top: 10px;
      background-color: #ffcc00;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover {
      background-color: #ffaa00;
    }
    #game-area {
      margin-top: 30px;
    }
  </style>
</head>
<body>
  <h1>Guessing Game 🎮</h1>
  <div id="game-area">
    <p id="text"></p>
    <input type="text" id="input" placeholder="Type here..." />
    <br>
    <button id="submit">Submit</button>
  </div>

  <script>
    const text = document.getElementById("text");
    const input = document.getElementById("input");
    const button = document.getElementById("submit");

    let step = 0;
    let name = "";
    let answer = Math.floor(Math.random() * 50) + 1;

    text.textContent = "I'm trying to make a website with the little coding I know.\nWho are you?";

    button.addEventListener("click", () => {
      const value = input.value.trim();
      input.value = "";

      if (step === 0) {
        name = value || "Player";
        text.textContent = `Hey, ${name}!\nLet's play a game!\nAre you in? (yes or no)`;
        step = 1;
      } 
      else if (step === 1) {
        if (value.toLowerCase() === "yes") {
          text.textContent = "Great choice, let's play!!\nChoose a number from 1 to 50:";
          step = 2;
        } else {
          text.textContent = "But I really wanted to play :(\nTry again? (yes or no)";
          step = 3;
        }
      } 
      else if (step === 3) {
        if (value.toLowerCase() === "yes") {
          text.textContent = "Great!! Choose a number from 1 to 50:";
          step = 2;
        } else {
          text.textContent = "Aww, maybe next time :(";
          step = 99;
        }
      } 
      else if (step === 2) {
        const guess = parseInt(value);
        if (isNaN(guess) || guess < 1 || guess > 50) {
          text.textContent = "Please enter a number between 1 and 50!";
          return;
        }

        if (guess < answer) {
          text.textContent = "Wrong :P\nTry going higher?";
        } else if (guess > answer) {
          text.textContent = "Wrong :P\nTry going lower?";
        } else {
          text.textContent = `Yayyy, you won, ${name}!!\nThe number was ${answer}!\nTook you long enough :)`;
          step = 99;
        }
      }
    });
  </script>
</body>
</html>
